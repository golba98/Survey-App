{
  "name": "25-survey-app",
  "version": "1.0.0",
  "type": "module",
  "description": "Cloudflare Worker + static assets + D1 survey app for a South African economy data visualisation project",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create 25-survey-app-db",
    "db:apply": "wrangler d1 migrations apply 25-survey-app-db --remote",
    "db:apply:local": "wrangler d1 execute DB --local --file=schema.sql",
    "seed:synthetic:dry-run": "node scripts/seed-synthetic-responses.mjs",
    "seed:synthetic": "node scripts/seed-synthetic-responses.mjs --apply",
    "seed:synthetic:local": "node scripts/seed-synthetic-responses.mjs --apply --local",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --test src/**/*.test.js",
    "test:worker": "vitest run"
  },
  "keywords": [
    "survey",
    "cloudflare",
    "d1",
    "worker",
    "data-visualisation",
    "south-africa",
    "economy"
  ],
  "author": "Data Visualisation Project Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.7",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
